index 0000000..da8916b
--- /dev/null
+++ b/net01d/followup02/native/session-ram-pair-01/compare_tail.py
@@ -0,0 +1,61 @@
+"""Small matched-STEP tail supplement; only two800-row control traces read."""
+import json
+import math
+from pathlib import Path
+
+OUT=Path(__file__).resolve().parent
+BASE=OUT.parents[1]
+
+
+def steps(name):
+    path=BASE/'runs'/name/'hub/native/control-step-trace.jsonl'
+    with path.open() as stream:
+        return {r['horizon_ns']:dict(horizon_ns=r['horizon_ns'],
+            CPU_ns=r['end_thread_cpu_ns']-r['begin_thread_cpu_ns'],
+            wall_ns=r['end_monotonic_ns']-r['begin_monotonic_ns'])
+            for r in map(json.loads,stream)}
+
+
+def tail(rows,key):
+    values=sorted(r[key] for r in rows)
+    return dict(n=len(values),p95_ns=values[math.ceil(.95*len(values))-1],
+        p99_ns=values[math.ceil(.99*len(values))-1],max_ns=values[-1],sum_ns=sum(values))
+
+
+ref=steps('ntcp-ram-r1');can=steps('ntcp-ram-c1')
+paired=[]
+for horizon in sorted(ref.keys()&can.keys()):
+    a,b=ref[horizon],can[horizon]
+    paired.append(dict(horizon_ns=horizon,reference=a,candidate=b,
+        CPU_delta_ns=b['CPU_ns']-a['CPU_ns'],wall_delta_ns=b['wall_ns']-a['wall_ns']))
+top={}
+for metric in ('CPU_ns','wall_ns'):
+    chosen=sorted(paired,key=lambda r:r['reference'][metric],reverse=True)[:10]
+    top[metric]=dict(rows=chosen,reference_sum_ns=sum(r['reference'][metric] for r in chosen),
+        candidate_same_horizons_sum_ns=sum(r['candidate'][metric] for r in chosen),
+        candidate_higher_count=sum(r['candidate'][metric]>r['reference'][metric] for r in chosen))
+    top[metric]['change_percent']=100*(top[metric]['candidate_same_horizons_sum_ns']/top[metric]['reference_sum_ns']-1)
+# Fixed .1sim bins of ten10ms STEP horizons: choose the three heaviest reference
+# CPU bins, then compare those exact bins rather than cherry-picking candidate bins.
+bins={}
+for row in paired:
+    slot=(row['horizon_ns']-1)//100_000_000
+    bins.setdefault(slot,[]).append(row)
+windows=[]
+for slot,rows in sorted(bins.items(),key=lambda item:sum(r['reference']['CPU_ns'] for r in item[1]),reverse=True)[:3]:
+    sums={arm:{key:sum(r[arm][key] for r in rows) for key in ('CPU_ns','wall_ns')} for arm in ('reference','candidate')}
+    windows.append(dict(begin_horizon_exclusive_ns=slot*100_000_000,end_horizon_inclusive_ns=(slot+1)*100_000_000,
+        step_count=len(rows),sums=sums,CPU_change_percent=100*(sums['candidate']['CPU_ns']/sums['reference']['CPU_ns']-1),
+        wall_change_percent=100*(sums['candidate']['wall_ns']/sums['reference']['wall_ns']-1)))
+summary=dict(scope='One existing fixed pair, matched Run STEP tails only; not END or ROS300ms qualification',
+    source_paths=[str(BASE/'runs'/name/'hub/native/control-step-trace.jsonl') for name in ('ntcp-ram-r1','ntcp-ram-c1')],
+    reference_steps=len(ref),candidate_steps=len(can),horizon_sets_equal=ref.keys()==can.keys(),paired_steps=len(paired),
+    percentile_method='nearest-rank ceil(p*n)',
+    Run_tail={arm:{key:tail(rows.values(),key) for key in ('CPU_ns','wall_ns')} for arm,rows in (('reference',ref),('candidate',can))},
+    reference_heaviest10_matched=top,reference_heaviest_three_fixed_0_1sim_windows=windows,
+    paired_candidate_higher_counts={key:sum(r['candidate'][key]>r['reference'][key] for r in paired) for key in ('CPU_ns','wall_ns')},
+    calls=dict(model=0,packetledger_reads=0,PCAP_reads=0,ROS=0),
+    caveats=['The two arms are not repeated benchmark samples; tails reflect actual scheduling plus instrumentation in this pair.',
+        'Matched horizon tails cannot establish continuous full-load health/mask deadlines; existing whole-cost increase remains.'])
+with (OUT/'comparison-tail.json').open('x') as stream:json.dump(summary,stream,indent=2);stream.write('\n')
+print(json.dumps(summary,indent=2))
