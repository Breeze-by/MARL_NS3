@@ -0,0 +1,98 @@
+"""Offline mapping of the one captured native RIP stream; does not load targets."""
+from collections import Counter,defaultdict
+import argparse
+import json
+from pathlib import Path
+import struct
+import subprocess
+
+HERE=Path(__file__).resolve().parent
+parser=argparse.ArgumentParser();parser.add_argument('--capture',type=Path)
+args=parser.parse_args();capture=HERE/'capture' if args.capture is None else args.capture.resolve()
+output=HERE if args.capture is None else capture/'analysis'
+if args.capture is not None:output.mkdir(exist_ok=False)
+raw=(capture/'cpu-ip.raw').read_bytes()
+values=struct.unpack_from('<8s15Q',raw)
+names=('version','header_bytes','record_bytes','requested_interval_us','capacity','captured',
+       'delivered','overflow','dump_complete','cpu_begin_ns','cpu_end_ns','wall_begin_ns','wall_end_ns','pid','ppid')
+header=dict(zip(names,values[1:]))
+assert values[0]==b'NIPCPU1\0' and header['version']==1 and header['header_bytes']==128 and header['record_bytes']==8
+assert header['dump_complete']==1 and len(raw)==128+8*header['captured']
+pcs=Counter(struct.unpack_from('<'+str(header['captured'])+'Q',raw,128))
+regions=[]
+for line in (capture/'native.startup.maps.txt').read_text().splitlines():
+    fields=line.split(None,5);start,end=(int(v,16) for v in fields[0].split('-'))
+    regions.append(dict(start=start,end=end,permissions=fields[1],offset=int(fields[2],16),
+                        path=fields[5] if len(fields)>5 else '[anonymous]'))
+by_module=defaultdict(list);outside=[]
+for pc,count in pcs.items():
+    region=next((r for r in regions if r['start']<=pc<r['end']),None)
+    if region is None:outside.append(dict(pc=hex(pc),samples=count));continue
+    by_module[region['path']].append((pc,count,region))
+artifact=output/'offline-symbols';artifact.mkdir(exist_ok=False)
+module_results=[];resolved_pcs=[]
+for path,points in sorted(by_module.items(),key=lambda item:-sum(p[1] for p in item[1])):
+    module=dict(path=path,total_samples=sum(p[1] for p in points),unique_PCs=len(points))
+    if not path.startswith('/'):
+        module.update(symbol_scope='No file-backed ELF; retained unresolved',unknown_samples=module['total_samples'])
+        module_results.append(module);continue
+    layout=subprocess.check_output(['rtk','proxy','readelf','-W','-h','-l','-S',path],text=True)
+    stem=Path(path).name;(artifact/(stem+'.readelf.txt')).write_text(layout)
+    segments=[]
+    for line in layout.splitlines():
+        fields=line.split()
+        if fields and fields[0]=='LOAD' and 'E' in ''.join(fields[6:-1]):
+            segments.append(dict(offset=int(fields[1],16),vaddr=int(fields[2],16),size=int(fields[4],16)))
+    command=['rtk','proxy','nm','-n','-S','--defined-only','--demangle']
+    if '.symtab' not in layout:command.append('--dynamic')
+    command.append(path)
+    completed=subprocess.run(command,text=True,capture_output=True,check=True)
+    (artifact/(stem+'.nm.txt')).write_text(completed.stdout)
+    (artifact/(stem+'.nm.stderr.txt')).write_text(completed.stderr)
+    grouped={}
+    for line in completed.stdout.splitlines():
+        fields=line.split(None,3)
+        if len(fields)!=4 or fields[2] not in ('T','t','W','w','i'):continue
+        start,size=int(fields[0],16),int(fields[1],16)
+        if size:grouped.setdefault((start,start+size),set()).add(fields[3])
+    symbols=[(a,b,tuple(sorted(aliases))) for (a,b),aliases in sorted(grouped.items())]
+    translated=[]
+    for pc,count,region in points:
+        file_offset=pc-region['start']+region['offset']
+        segment=next((s for s in segments if s['offset']<=file_offset<s['offset']+s['size']),None)
+        elf_pc=None if segment is None else file_offset-segment['offset']+segment['vaddr']
+        translated.append((elf_pc,pc,count))
+    cursor=0;active=[];rank=Counter();categories=Counter();unknown=[]
+    for elf_pc,pc,count in sorted(translated,key=lambda row:-1 if row[0] is None else row[0]):
+        candidates=[]
+        if elf_pc is not None:
+            while cursor<len(symbols) and symbols[cursor][0]<=elf_pc:
+                active.append(symbols[cursor]);cursor+=1
+            active=[s for s in active if s[1]>elf_pc]
+            candidates=[s for s in active if s[0]<=elf_pc<s[1]]
+        if elf_pc is None:category='outside_ELF_executable_file_extent'
+        elif len(candidates)==1:
+            category='unambiguous_symbol_span';rank[candidates[0]]+=count
+        elif candidates:category='overlapping_distinct_symbol_spans'
+        else:category='unknown_symbol_in_ELF_executable_extent'
+        categories[category]+=count
+        detail=dict(pc=hex(pc),ELF_pc=None if elf_pc is None else hex(elf_pc),samples=count,category=category,
+            candidates=[dict(start=hex(a),end_exclusive=hex(b),aliases=list(aliases)) for a,b,aliases in candidates])
+        resolved_pcs.append(dict(path=path,**detail))
+        if category!='unambiguous_symbol_span':unknown.append(detail)
+    module.update(symbol_scope='.symtab' if '.symtab' in layout else '.dynsym only; internal stripped implementations remain unknown',
+        sample_categories=dict(categories),ranking=[dict(start=hex(a),end_exclusive=hex(b),aliases=list(aliases),samples=count)
+            for (a,b,aliases),count in rank.most_common()],unknown_PCs=unknown)
+    module_results.append(module)
+    print(json.dumps(dict(module=path,samples=module['total_samples'],categories=dict(categories),leading=module['ranking'][:8])))
+result=dict(status='COARSE_NATIVE_LIFETIME_IP_SAMPLES',header=header,total_samples=sum(pcs.values()),
+    unique_PCs=len(pcs),outside_startup_maps=outside,modules=module_results,
+    capture=str(capture),source='Actual capture/native-exec.json and separately preserved admitted C/compile snapshots; no model retry',
+    limitations='Raw sampled instruction pointers, no callers/call stack or model-vs-diagnostic classification. '
+        'Module counts are sample distribution, not an exact CPU-time allocation. Startup maps do not prove no later dlopen. '
+        'ELF symbols use actual start+size, exact aliases grouped, zero-size/stripped/ambiguous extents remain unknown. '
+        'GNUtime includes runner/Hub/children; controlRun and sampler-active scopes differ. '
+        'Counts cover the sampler active lifetime and cannot be split into phases without PC timestamps. '
+        'The fixed18RX/8sim case and fullROS fixture are distinct workloads; neither proves a dominant fault cause from PC counts alone.')
+(output/'sample-PCs.json').write_text(json.dumps(resolved_pcs,indent=2)+'\n')
+(output/'sample-symbols.json').write_text(json.dumps(result,indent=2)+'\n')
