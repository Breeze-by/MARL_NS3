+#endif
+
+enum { CAPACITY=262144, INTERVAL_US=1000 };
+static uint64_t samples[CAPACITY]; /* Fixed2MiB BSS, chronological, no overwrite. */
+static volatile sig_atomic_t captured,delivered,overflow;
+static int output_fd=-1,enabled;
+struct Header {
+    char magic[8];
+    uint64_t version,header_bytes,record_bytes,requested_interval_us,capacity;
+    uint64_t captured,delivered,overflow,dump_complete;
+    uint64_t cpu_begin_ns,cpu_end_ns,wall_begin_ns,wall_end_ns,pid,ppid;
+};
+_Static_assert(sizeof(struct Header)==128,"Review raw header layout");
+static struct Header header={.magic={'N','I','P','C','P','U','1','\0'},
+    .version=1,.header_bytes=sizeof(struct Header),.record_bytes=sizeof(uint64_t),
+    .requested_interval_us=INTERVAL_US,.capacity=CAPACITY};
+
+static void fail(void) {
+    static const char message[]="NET01 CPU-IP sampler setup/finalization failed\n";
+    ssize_t result=write(STDERR_FILENO,message,sizeof(message)-1);
+    (void)result;
+    _exit(126);
+}
+static uint64_t now_ns(clockid_t clock) {
+    struct timespec value;
+    if(clock_gettime(clock,&value))fail();
+    return (uint64_t)value.tv_sec*1000000000ULL+(uint64_t)value.tv_nsec;
+}
+static void write_at(int fd,const void *data,size_t size,off_t offset) {
+    const unsigned char *next=data;
+    while(size) {
+        ssize_t count=pwrite(fd,next,size,offset);
+        if(count<0 && errno==EINTR)continue;
+        if(count<=0)fail();
+        next+=count;size-=(size_t)count;offset+=count;
+    }
+}
+static void save_startup_maps(const char *path) {
+    int source=open("/proc/self/maps",O_RDONLY|O_CLOEXEC);
+    int target=open(path,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);
+    if(source<0 || target<0)fail();
