new file mode 100644
index 0000000..7148541
--- /dev/null
+++ b/net01d/followup02/native/wifi-profile-01/parse_histogram.py
@@ -0,0 +1,70 @@
+"""Offline, fixed-file glibc2.35 shared-DSO histogram; no model or sprof load."""
+from collections import Counter
+import json
+from pathlib import Path
+import struct
+import subprocess
+
+HERE=Path(__file__).resolve().parent
+ELF=Path('/home/zhuyulab/ns3-workspace/net-01d/ns3-lto-portable-followup02/build/lib/libns3.40-wifi.so')
+PROFILE=HERE/'ld-profile/libns3.40-wifi.so.profile'
+raw=PROFILE.read_bytes()
+assert raw[:4]==b'gmon' and struct.unpack_from('<I',raw,4)[0]==0x1ffff
+assert struct.unpack_from('<I',raw,20)[0]==0
+low,high,bins,rate=struct.unpack_from('<QQII',raw,24)
+assert high-low==4*bins and len(raw)>=64+2*bins
+counts=struct.unpack_from('<'+str(bins)+'H',raw,64)
+layout=subprocess.check_output(['rtk','proxy','readelf','-W','-h','-l','-S',str(ELF)],text=True)
+assert '.symtab' in layout and 'ELF64' in layout and 'little endian' in layout
+(HERE/'histogram-elf-layout.txt').write_text(layout)
+nm=subprocess.check_output(['rtk','proxy','nm','-n','-S','--defined-only','--demangle',str(ELF)],text=True)
+(HERE/'histogram-nm-symbols.txt').write_text(nm)
+grouped={}
+for line in nm.splitlines():
+    fields=line.split(None,3)
+    if len(fields)!=4 or fields[2] not in ('T','t','W','w','i'):continue
+    start,size=int(fields[0],16),int(fields[1],16)
+    if size:grouped.setdefault((start,start+size),[]).append(fields[3])
+symbols=[dict(start=a,end=b,names=sorted(set(names))) for (a,b),names in sorted(grouped.items())]
+segments=[]
+for line in layout.splitlines():
+    fields=line.split()
+    if fields and fields[0]=='LOAD' and 'E' in ''.join(fields[6:-1]):
+        segments.append((int(fields[2],16),int(fields[2],16)+int(fields[5],16)))
+cursor=0;active=[];mapped=Counter();categories=Counter();nonzero=[]
+for index,ticks in enumerate(counts):
+    if not ticks:continue
+    begin=low+4*index;end=begin+4
+    while cursor<len(symbols) and symbols[cursor]['start']<end:
+        active.append(symbols[cursor]);cursor+=1
+    active=[s for s in active if s['end']>begin]
+    candidates=[s for s in active if s['start']<end and s['end']>begin]
+    if len(candidates)==1 and candidates[0]['start']<=begin and candidates[0]['end']>=end:
+        category='unambiguous_symbol_span';s=candidates[0];mapped[(s['start'],s['end'],tuple(s['names']))]+=ticks
+    elif candidates:category='ambiguous_boundary_or_overlapping_symbol_spans'
+    elif any(a<=begin and end<=b for a,b in segments):category='unknown_symbol_inside_DSO_executable_segment'
+    else:category='outside_actual_executable_segment_within_profile_page_range'
+    categories[category]+=ticks
+    nonzero.append(dict(index=index,start=hex(begin),end_exclusive=hex(end),ticks=ticks,category=category,
+        candidate_spans=[dict(start=hex(s['start']),end_exclusive=hex(s['end']),names=s['names']) for s in candidates]))
+ranking=[dict(start=hex(a),end_exclusive=hex(b),names=list(names),unambiguous_ticks=ticks)
+    for (a,b,names),ticks in mapped.most_common()]
+result=dict(status='OFFLINE_COARSE_HISTOGRAM_ONLY',profile=str(PROFILE),ELF=str(ELF),
+    format_source='https://raw.githubusercontent.com/bminor/glibc/glibc-2.35/elf/dl-profile.c',
+    local_headers=['/usr/include/x86_64-linux-gnu/sys/gmon_out.h','/usr/include/x86_64-linux-gnu/sys/gmon.h'],
+    format=dict(version=hex(0x1ffff),tag_offset=20,count_offset=64,counter_bits=16,
+        low_pc=hex(low),high_pc=hex(high),bins=bins,address_bytes_per_bin=4,sampling_rate_hz=rate,
+        dimension=raw[48:63].rstrip(b'\0').decode(),abbreviation=chr(raw[63]),
+        histogram_end_offset=64+2*bins,next_tag=struct.unpack_from('<I',raw,64+2*bins)[0]),
+    total_ticks=sum(counts),nonzero_bins=len(nonzero),saturated_bins=sum(c==65535 for c in counts),
+    tick_categories=dict(categories),symbol_spans=len(symbols),ranking=ranking,
+    scope='Single selected WiFi DSO PC histogram, no call stack or total process CPU denominator. '
+        'External libm/libc/other DSOs/native-driver time not sampled here. Bin ticks crossing a function '
+        'boundary or overlapping symbol spans remain ambiguous and are not assigned. Aliases with identical '
+        'spans are grouped. Zero-size/unmapped symbols and code padding remain unknown. '
+        'glibc statistical ticks are coarse; no per-call timing or causal bug attribution. '
+        'sprof exit127 is preserved; this decoder executes neither target ELF nor sprof.')
+(HERE/'histogram-nonzero-bins.json').write_text(json.dumps(nonzero,indent=2)+'\n')
+(HERE/'histogram-symbols.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps({k:result[k] for k in ('status','total_ticks','nonzero_bins','tick_categories')}))
+print(json.dumps(ranking[:20],indent=2))
